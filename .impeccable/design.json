  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Direct study or project action.",
      "html": "<button class=\"ds-primary\">공부 시작하기</button>",
      "css": ".ds-primary{font-family:var(--font,Pretendard,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif);font-size:16px;line-height:1.6;letter-spacing:-.025em;border:0;cursor:pointer;background:var(--green,#3d7a5d);color:var(--on-primary,#ffffff);border-radius:10px;font-weight:650;min-height:46px;padding:10px 22px;transition:background .16s,color .16s,transform .16s}.ds-primary:hover{background:var(--green-hover,#315f49)}.ds-primary:focus-visible{outline:3px solid var(--green-text,#315f49);outline-offset:4px;}.ds-primary:active{transform:scale(.98)}.ds-primary:disabled{opacity:.55;cursor:default}"
    },
    {
      "name": "Text Button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Quiet supporting action.",
      "html": "<button class=\"ds-text\">모두 보기</button>",
      "css": ".ds-text{font-family:var(--font,Pretendard,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif);font-size:16px;line-height:1.6;letter-spacing:-.025em;border:0;background:none;cursor:pointer;min-height:44px;color:var(--muted,#566159);font-size:12px;padding:7px 0;transition:color .16s,transform .16s}.ds-text:hover{color:var(--green-text,#315f49)}.ds-text:focus-visible{outline:3px solid var(--green-text,#315f49);outline-offset:4px;}.ds-text:active{transform:scale(.98)}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Short labeled profile or recruitment entry.",
      "html": "<label class=\"ds-label\">프로젝트 이름<input class=\"ds-input\" placeholder=\"함께 만들고 싶은 프로젝트\"></label>",
      "css": ".ds-label{font-family:var(--font,Pretendard,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif);font-size:16px;line-height:1.6;letter-spacing:-.025em;display:grid;gap:8px;font-size:14px;font-weight:600;color:var(--text,#1f2923)}.ds-input{font-family:var(--font,Pretendard,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif);font-size:16px;line-height:1.6;letter-spacing:-.025em;width:100%;min-height:46px;background:var(--bg,#e2e4df);border:1px solid var(--accent,#b2b8a3);border-radius:8px;padding:10px 12px;color:var(--text,#1f2923);caret-color:var(--green,#3d7a5d)}.ds-input:focus-visible{outline:3px solid var(--green-text,#315f49);outline-offset:4px;}"
    },
    {
      "name": "Status Tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Compact project or member status.",
      "html": "<span class=\"ds-tag\">팀원 모집</span>",
      "css": ".ds-tag{font-family:var(--font,Pretendard,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif);font-size:16px;line-height:1.6;letter-spacing:-.025em;color:var(--green-text,#315f49);background:var(--mint,#e2e4df);padding:3px 8px;border-radius:5px;font-size:11px;white-space:nowrap}"
    },
    {
      "name": "Selected Filter",
      "kind": "chip",
      "refersTo": "filter-selected",
      "description": "Selected activity category.",
      "html": "<button class=\"ds-filter\" aria-pressed=\"true\">팀원 모집</button>",
      "css": ".ds-filter{font-family:var(--font,Pretendard,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif);font-size:16px;line-height:1.6;letter-spacing:-.025em;border:0;cursor:pointer;font-size:13px;background:var(--green,#3d7a5d);color:var(--on-primary,#ffffff);padding:8px 15px;border-radius:8px;min-height:44px;transition:transform .16s}.ds-filter:focus-visible{outline:3px solid var(--green-text,#315f49);outline-offset:4px;}.ds-filter:active{transform:scale(.98)}"
    },
    {
      "name": "Desktop Active Navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Selected primary destination with SVG icon.",
      "html": "<button class=\"ds-nav\" aria-current=\"page\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"m3 10 9-7 9 7v10h-6v-7H9v7H3Z\"/></svg><span>홈</span></button>",
      "css": ".ds-nav{font-family:var(--font,Pretendard,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif);font-size:16px;line-height:1.6;letter-spacing:-.025em;border:0;cursor:pointer;display:flex;align-items:center;gap:14px;padding:14px 18px;margin:5px 0;border-radius:12px;background:var(--mint,#e2e4df);color:var(--green-text,#315f49);font-weight:600;transition:background .16s,transform .16s}.ds-nav svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-nav:hover{background:var(--bg,#e2e4df)}.ds-nav:focus-visible{outline:3px solid var(--green-text,#315f49);outline-offset:4px;}.ds-nav:active{transform:scale(.98)}"
    },
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat translucent reading surface with a greige heading backplate.",
      "html": "<section class=\"ds-panel\"><h2>함께 달리는 공부 랭킹</h2><p>작은 몰입을 함께 쌓아요.</p></section>",
      "css": ".ds-panel{font-family:var(--font,Pretendard,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif);font-size:16px;line-height:1.6;letter-spacing:-.025em;background:var(--desk-surface,#fafbf9f5);border-radius:var(--radius,16px);padding:26px;color:var(--text,#1f2923)}.ds-panel h2{display:table;max-width:100%;width:fit-content;background:var(--heading-bg,#e2e4df);color:var(--text,#1f2923);padding:7px 11px;border-radius:8px;line-height:1.45;font-size:17px;margin:0 0 17px;font-weight:700}.ds-panel p{font-size:12px;color:var(--muted,#566159);margin:0}@media(max-width:850px){.ds-panel{padding:22px}.ds-panel h2{font-size:16px}}@media(max-width:380px){.ds-panel{padding:20px}.ds-panel h2{font-size:15px}}"
    },
    {
      "name": "Page Title Backplate",
      "kind": "custom",
      "description": "Readable page heading on the decorative desk background.",
      "html": "<h1 class=\"ds-page-title\">함께 성장하는 유위드</h1>",
      "css": ".ds-page-title{font-family:var(--font,Pretendard,sans-serif);display:table;max-width:100%;background:var(--surface,#fafbf9);color:var(--text,#1f2923);padding:10px 16px;border-radius:10px;font-size:30px;line-height:1.4;font-weight:750;letter-spacing:-.035em;margin:0 0 8px;box-decoration-break:clone;-webkit-box-decoration-break:clone}@media(max-width:850px){.ds-page-title{font-size:26px;padding:9px 12px}}@media(max-width:380px){.ds-page-title{font-size:23px}}"
    },
    {
      "name": "Settings Switch",
      "kind": "custom",
      "refersTo": "settings-switch-off",
      "description": "Native checkbox switch; the entire 86px label row activates the control. Check to preview ON.",
      "html": "<label class=\"ds-setting-row\"><span><strong>다크모드</strong><small>눈이 편한 어두운 화면으로 전환해요.</small></span><input class=\"ds-setting-switch\" type=\"checkbox\" role=\"switch\" aria-label=\"다크모드\"></label>",
      "css": ".ds-setting-row{font-family:var(--font,Pretendard,sans-serif);display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:86px;padding:18px 0;border-bottom:1px solid var(--line,#d5d9d0);color:var(--text,#1f2923)}.ds-setting-row strong{display:block;font-size:15px;font-weight:650}.ds-setting-row small{display:block;font-size:12px;line-height:1.6;color:var(--muted,#566159);margin-top:5px}.ds-setting-switch{appearance:none;position:relative;flex-shrink:0;width:48px;height:28px;padding:0;border:2px solid var(--muted,#566159);border-radius:16px;background:var(--mint,#e2e4df);cursor:pointer;transition:background .16s}.ds-setting-switch::before{content:\"\";position:absolute;left:3px;top:3px;width:18px;height:18px;border-radius:50%;background:var(--muted,#566159);transition:transform .16s}.ds-setting-switch:checked{background:var(--green,#3d7a5d);border-color:var(--green,#3d7a5d)}.ds-setting-switch:checked::before{transform:translateX(20px);background:var(--on-primary,#ffffff)}.ds-setting-switch:hover{border-color:var(--green-text,#315f49)}.ds-setting-switch:focus-visible{outline:3px solid var(--green-text,#315f49);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-setting-switch,.ds-setting-switch::before{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "Together, One Step at a Time",
    "overview": "YouWith is a quiet, practical workspace for approved university club members. The supplied clover remains its identity anchor; the user-selected Sage Green & Greige palette and pale photographic desk ground give it a calm study atmosphere. Concise Korean copy, clear study actions, and readable project rows express the user’s Toss-like preference.\n\nThis system documents the local HTML/CSS/JavaScript prototype in frontend/. It governs app screens, while PRODUCT.md owns product scope. Home A is fixed. Comparison controls and B/C-specific code are removed. The home title and supporting sentence share one panel.",
    "keyCharacteristics": [
      "Sage green for primary actions and selected states.",
      "Readable Korean hierarchy with restrained supporting copy.",
      "Pale desk photography, translucent off-white panels, and solid heading backplates with direct, labeled actions.",
      "Five internal destinations (홈, 공부, 놀이터, 활동, 내 정보). Desktop also has Instagram; mobile exposes Instagram only inside Settings. Settings opens from the gear header icon or profile."
    ],
    "rules": [
      {
        "name": "The Semantic Theme Rule",
        "body": "Change color roles in theme.css; keep text green (`green-text`), button fill (`green`), and button hover (`green-hover`) separate. New screens consume these roles rather than adding local light-only fills.",
        "section": "colors"
      },
      {
        "name": "The Clover Action Rule",
        "body": "Use sage green for the main action and selected state; keep the warm apple accent attached to the game context.",
        "section": "colors"
      },
      {
        "name": "The Readable Record Rule",
        "body": "Keep study numerals tabular and pair project titles with short role or recruiting descriptions.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Separate everyday content with off-white or greige fills and quiet dividers; reserve shadows for selected tabs and overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the supplied clover, five labeled internal destinations, and Instagram in the correct desktop/settings locations.",
      "Do use the Sage Green & Greige light tokens, forest dark overrides, semantic color roles, and the shared Pretendard stack.",
      "Do preserve solid heading backplates and translucent reading surfaces over the decorative desk photograph.",
      "Do keep primary study and project actions explicit in Korean.",
      "Do preserve keyboard focus, pressed/current states, reduced-motion support, and mobile safe-area spacing.",
      "Do label fictional records and prototype-only workflows as examples."
    ],
    "donts": [
      "Don't promote one home composition into a requirement for every screen.",
      "Don't introduce decorative gradients, dense ornamental surfaces, or extra brand accents without a new design decision.",
      "Don't turn simulated notifications into production requirements.",
      "Don't present system font fallback as a separate display-font identity."
    ]
  }
}
