{
  "name": "youwith-prototype",
  "private": true,
  "scripts": {
    "dev": "python -X utf8 server/auth_server.py serve",
    "test": "node --test tests/*.test.cjs",
    "test:server": "python -X utf8 -m unittest discover -s tests -p \"test_notice*.py\"",
    "notices:refresh": "python -X utf8 server/refresh_notices.py",
    "user:create": "python -X utf8 server/auth_server.py create-user",
    "user:password": "python -X utf8 server/auth_server.py reset-password",
    "test:auth": "python -X utf8 -m unittest discover -s tests -p \"test_auth*.py\"",
    "members:list": "python -X utf8 server/auth_server.py members",
    "members:approve": "python -X utf8 server/auth_server.py approve",
    "members:revoke": "python -X utf8 server/auth_server.py revoke",
    "notices:job": "python -X utf8 server/notice_job.py",
    "notices:refresh:apis": "python -X utf8 server/refresh_notices.py --apis-only"
  }
}
